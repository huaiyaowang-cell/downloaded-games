BUCKET: your-bucket-name
# GC_KEY 支持三种方式:
# 1) 直接填 service-account 的 JSON 对象
# 2) JSON 字符串
# 3) 本机 JSON 文件路径（推荐）
GC_KEY: /absolute/path/to/service-account.json

# 桶内前缀，默认 r_game
BUCKET_TARGET: r_game

# 为空表示自动上传项目根目录下所有一级文件夹（会排除 .git/scripts/node_modules 等）
# UPLOAD_INCLUDE_FOLDERS 也支持“配置文件/文件夹”：
# - 直接填一级文件夹名字（相对项目根目录）
# - 填配置文件路径：每行一个一级文件夹名（也支持 JSON 数组）
# - 填文件夹路径（例如 `./some_dir` 或绝对路径）：枚举该目录下的子目录作为要上传的根目录
UPLOAD_INCLUDE_FOLDERS: []

# 当 UPLOAD_INCLUDE_FOLDERS 为空时，这些一级文件夹会被排除
UPLOAD_EXCLUDE_FOLDERS:
  - .git
  - .cursor
  - .output
  - node_modules
  - scripts
  - __pycache__

# 文件名过滤（基于文件名 glob）
UPLOAD_INCLUDE_FILES: []
UPLOAD_EXCLUDE_FILES: []

# 离线包专用游戏列表（优先于 UPLOAD_INCLUDE_FOLDERS）
# 留空时，离线包脚本会回退使用 UPLOAD_INCLUDE_FOLDERS
OFFLINE_INCLUDE_FOLDERS: []

# 离线包上传优化参数（大文件建议调大超时/重试）
OFFLINE_UPLOAD_TIMEOUT_SEC: 900
OFFLINE_UPLOAD_RETRIES: 4
OFFLINE_UPLOAD_CHUNK_SIZE_MB: 8

# 离线包上传优化参数（大文件建议调大超时/重试）
OFFLINE_UPLOAD_TIMEOUT_SEC: 900
OFFLINE_UPLOAD_RETRIES: 4
OFFLINE_UPLOAD_CHUNK_SIZE_MB: 8
