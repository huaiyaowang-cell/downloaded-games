el-devil-logo.png","url":"\u002Fzh\u002Fg\u002Flevel-devil","slug":"level-devil","animatedThumbnail":"c5f90554-50a7-48c7-8fef-d42420df7c21\u002Fthumbnail"}],"fulfilledTimeStamp":1787642280082},"getGame({\"device\":\"desktop\",\"geo\":\"CN\",\"pageType\":\"game\",\"path\":\"\u002Fzh\u002Fg\u002Fdogs-life\",\"site\":{\"domain\":\"poki.com\",\"domain_title\":\"Poki.com\",\"id\":73,\"iso_lang\":\"zh\",\"lang\":\"zh\",\"languageName\":\"简体中文\",\"locale\":\"zh_CN\",\"paths\":{\"prefix\":\"\u002Fzh\"},\"title\":\"Poki (宝玩)\"},\"slug\":\"dogs-life\"})":{"status":"fulfilled","endpointName":"getGame","requestId":"cRWDE2cd-mEIcDybz77Zq","originalArgs":{"slug":"dogs-life","site":{"id":73,"lang":"zh","title":"Poki (宝玩)","languageName":"简体中文","domain":"poki.com","domain_title":"Poki.com","iso_lang":"zh","locale":"zh_CN","paths":{"prefix":"\u002Fzh"}},"device":"desktop","geo":"CN","pageType":"game","path":"\u002Fzh\u002Fg\u002Fdogs-life"},"startedTimeStamp":1787642280079,"data":{"id":32238,"developer":"Critters Studio","developers":["Critters Studio"],"fullscreen":false,"allow_smart_refresh":true,"desktop_available":true,"mobile_available":true,"slug":"dogs-life","title":"Dog's Life","english_title":"Dog's Life","intro":"Dog's Life 是一款模拟游戏，让你化身顽皮小狗。漫游家中房间，收集骨头，与日常物品互动。享受每日冒险，体验宠物生活。","description":"\u003Cp\u003E\n《狗狗生活》是一款模拟游戏，你将扮演一只可爱的小狗，探索一整栋房子。在房间里闲逛，寻找骨头和金币，与你发现的所有东西互动，比如毛绒玩具、清洁机器人、眼镜，以及其他任何吸引你眼球的东西。或者干脆撕咬一番，何乐而不为呢？你是一只乖狗狗……大概吧。\u003C\u002Fp\u003E\n\n\u003Ch3\u003E如何玩《狗狗生活》？\u003C\u002Fh3\u003E\n\u003Cp\u003E\n点击或轻触进行选择。使用WASD键或摇杆移动。\u003C\u002Fp\u003E\n\n\u003Ch3\u003E谁创作了《狗狗生活》？\u003C\u002Fh3\u003E\n\u003Cp\u003E\n\n《狗狗生活》由 Critters Studio 开发。您还可以在以下平台玩他们的其他游戏： Poki (宝玩)： \u003Ca href=\"https:\u002F\u002Fpoki.com\u002Fzh\u002Fg\u002Fcat-simulator\"\u003ECat Simulator\u003C\u002Fa\u003E， \u003Ca href=\"https:\u002F\u002Fpoki.com\u002Fzh\u002Fg\u002Fmerge-zoo\"\u003EMerge Zoo\u003C\u002Fa\u003E 和 \u003Ca href=\"https:\u002F\u002Fpoki.com\u002Fzh\u002Fg\u002Fcritters-quest\"\u003ECritters Quest\u003C\u002Fa\u003E！\u003C\u002Fp\u003E\n\n\n\n\u003Ch3\u003E如何免费玩《狗狗生活》？\u003C\u002Fh3\u003E\n\u003Cp\u003E你可以在 Poki 上免费玩 Dog&#39;s Life。\u003C\u002Fp\u003E\n\n\u003Ch3\u003E我可以在手机和电脑上玩《狗狗生活》吗？\u003C\u002Fh3\u003E\n\u003Cp\u003E\n狗狗生活可以在电脑和移动设备（如手机和平板电脑）上玩。\u003C\u002Fp\u003E","meta":{"site_id":73,"title":"Dog's Life - 免费在线玩! | Poki (宝玩)","description":"在最受欢迎的免费在线小游戏网站上玩Dog's Life！Poki (宝玩)可在您的手机、平板电脑或电脑上运行。无需下载，无需登录。现在就玩！"},"file":{"content":"https:\u002F\u002Fgames.poki.com\u002F458768\u002Fd260cb39-ef9c-453d-926d-25ff54c345d9","orientation":"both","render_type":"unknown"},"mobile_file":{"content":"https:\u002F\u002Fgames.poki.com\u002F458768\u002Fd260cb39-ef9c-453d-926d-25ff54c345d9","orientation":"both","render_type":"unknown"},"content":"https:\u002F\u002Fgames.poki.com\u002F458768\u002Fd260cb39-ef9c-453d-926d-25ff54c345d9","orientation":"both","render_type":"unknown","breadcrumb":[{"id":64,"mobile":true,"slug":"动物","title":"动物游戏","short_title":"动物","image":{"path":"b9bdc9a88501dbcc3c477281ed9fdbbe\u002F动物-logo.png"},"image_url":"b9bdc9a88501dbcc3c477281ed9fdbbe\u002F动物-logo.png","iab_categories":"IAB9,IAB9-26,IAB9-30","icon":"animals","category_type":"theme","game_count":225}],"breadcrumbs":[{"id":64,"mobile":true,"slug":"动物","title":"动物游戏","short_title":"动物","image":{"path":"b9bdc9a88501dbcc3c477281ed9fdbbe\u002F动物-logo.png"},"image_url":"b9bdc9a88501dbcc3c477281ed9fdbbe\u002F动物-logo.png","iab_categories":"IAB9,IAB9-26,IAB9-30","icon":"animals","category_type":"theme","game_count":225}],"alternate_sites":{"ar":{"slug":"dogs-life","title":"Dog's Life"},"bg":{"slug":"dogs-life","title":"Dog's Life"},"bn":{"slug":"dogs-life","title":"Dog's Life"},"cs":{"slug":"dogs-life","title":"Dog's Life"},"da":{"slug":"dogs-life","title":"Dog's Life"},"de":{"slug":"dogs-life","title":"Dog's Life"},"el":{"slug":"dogs-life","title":"Dog's Life"},"en":{"slug":"dogs-life","title":"Dog's Life"},"es":{"slug":"dogs-life","title":"Dog's Life"},"fi":{"slug":"dogs-li